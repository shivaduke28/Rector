.rector-hud-header {
    height: 140px;
    padding: 40px 54px 20px 54px;
    flex-direction: row;
    margin-bottom: 0;
    align-items: flex-end;
    background-color: var(--rector-frame-dark);
}

.rector-hud-body {
    flex-grow: 1;
    flex-direction: row;
}

.rector-hud-footer {
    height: 168px;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    padding: 24px 54px 16px 54px;
    background-color: var(--rector-frame-dark);
}

.rector-hud-content-side-left {
    width: 54px;
    height: 100%;
    background-color: var(--rector-frame-dark);
}

.rector-hud-content-side-right {
    width: 54px;
    height: 100%;
    background-color: var(--rector-frame-dark);
}

.rector-hud-body-content-internal {
    flex-grow: 1;
    border-width: 1px;
    border-color: var(--rector-border-color);
}

.rector-hud-logo {
    margin: 0 0 -10px;
    padding: 0;
    background-image: url("project://database/Assets/Rector/StaticResources/Textures/RectorLogoTransparent.png?fileID=2800000&guid=09a80c6ddb98f4849b4b74cccbf89cd3&type=3#RectorLogoTransparent");
    width: 100px;
    height: 100px;
    -unity-background-image-tint-color: var(--rector-text-color);
}

.rector-hud-version-label {
    font-size: 18px;
    -unity-text-align: lower-left;
    margin-left: 12px;
    margin-bottom: -5px;
}

.rector-waveform-container {
    height: 100%;
    flex-direction: row;
    flex-grow: 1;
}

.rector-hud-spectrum {
    width: 360px;
    height: 100%;
    background-image: url("project://database/Assets/Rector/StaticResources/Materials/Spectrum.asset?fileID=8600000&guid=2945b991fdd29442782ebf8571ff5f05&type=2#Spectrum");
    border-width: 1px;
    border-color: var(--rector-border-color);
    align-items: flex-start;
}

.rector-hud-waveform {
    width: 360px;
    height: 100%;
    background-image: url("project://database/Assets/Rector/StaticResources/Materials/Waveform.asset?fileID=8600000&guid=1498d7bcad6264347b4f0099c060eec0&type=2#Waveform");
    margin-right: 35px;
    border-width: 1px;
    border-color: var(--rector-border-color);
    align-items: flex-start;
}

.rector-stats {
    width: 220px;
    height: 100%;
    margin-left: 24px;
    align-items: flex-start;
}

.rector-stats-header-label {
    font-size: 14px;
    margin-bottom: 2px;
}

.rector-stats-title-label {
    flex-grow: 0;
    -unity-text-align: middle-left;
    font-size: 12px;
    margin-left: 5px;
}

.rector-stats-label-container {
    flex-direction: row;
    justify-content: space-between;
    flex-grow: 1;
    width: 100%;
}

.rector-stats-label {
    font-size: 14px;
}

.rector-console {
    width: 540px;
    height: 100%;
    align-items: flex-start;
    margin-left: 30px;
}

.rector-console-mask {
    height: 100%;
    width: 100%;
    align-items: flex-start;
    overflow: hidden;
    margin-left: 5px;
}

.rector-console-content {
    align-items: flex-start;
}

.rector-console-log-label {
    -unity-text-align: middle-left;
    font-size: 10px;
}

.rector-page {
    position: absolute;
    flex-grow: 1;
}

.rector-button-list {
    align-items: flex-start;
    margin-left: 100px;
    margin-top: 100px;
}

.rector-copyright-notices-page {
    width: 100%;
    height: 100%;
    overflow: hidden;
}

.rector-copyright-notices-label {
    position: absolute;
}

.rector-graph-page {
    position: absolute;
    flex-grow: 1;
    flex-direction: row;
    width: 100%;
    height: 100%;
    align-items: flex-start;
}

.rector-graph-mask {
    overflow: hidden;
    flex-shrink: 1;
    flex-grow: 1;
    height: 100%;
}

.rector-graph-content {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-origin: left top;
}

.rector-graph-content-animation {
    transition-property: translate;
    transition-duration: 0.1s;
    transition-timing-function: linear;
}

.rector-group-guide-root {
    width: 100%;
    height: 100%;
    position: absolute;
    transform-origin: left top;
}

/* ラベルと枠を縦に積む入れ物。ラベルの幅は中身なりにしたいので align-items は flex-start。 */
.rector-group {
    position: absolute;
    align-items: flex-start;
    /* ノード (.rector-node) と同じ時間で動かす。瞬間移動させるとレイアウト変更の
       アニメーション中だけ枠とノードがずれて、はみ出したように見える。 */
    transition-property: left, top, width;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}

/* ノードを囲む矩形。フォーカス中のグループだけ枠線を出す。
   非表示側も同じ太さの透明borderを持たせて、切り替えでサイズが動かないようにする。 */
.rector-group-box {
    width: 100%;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    transition-property: height;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
}

.rector-group--active .rector-group-box {
    border-color: var(--rector-border-color);
}

/* 枠のすぐ上に左揃えで載せる。高さを決め打ちすると枠の余白がずれるので絶対配置にする。
   Label の既定 margin (2px) を消さないと、枠との間に隙間が空く。 */
.rector-group-label {
    position: absolute;
    bottom: 100%;
    left: 0;
    margin: 0;
    font-size: 10px;
    letter-spacing: 2px;
    padding: 2px 6px;
    -unity-text-align: middle-left;
    color: var(--rector-text-color);
    background-color: var(--rector-text-background-color);
}

.rector-group--active .rector-group-label {
    background-color: black;
}

.rector-node-root {
    position: absolute;
    flex-grow: 1;
    width: 100%;
    height: 100%;
}

.rector-node-detail {
    width: 360px;
    flex-direction: column;
    margin-top: 40px;
    margin-bottom: 0;
    padding: 20px;
}

.rector-node-detail-name-label-container {
    font-size: 18px;
    margin-bottom: 20px;
    align-items: center;
}

.rector-create-node-menu {
    position: absolute;
    flex-shrink: 0;
    flex-direction: row;
    align-items: flex-start;
    translate: 60px 30px;
}

.rector-create-node-menu-list {
    align-items: flex-start;
    margin-right: 4px;
}

.rector-create-node-menu-list > .rector-button > Button {
    background-color: rgba(20, 20, 20, 0.7);
    font-size: 12px;
}

.rector-create-node-menu-list > .rector-button--focused > Button {
    background-color: black;
}

.rector-node-category-button {
    flex-direction: row;
    justify-content: center;
    border-width: 1px;
}

.rector-node-category-button--focused {
    border-color: var(--rector-border-color);
}

.rector-node-category-button--highlighted {
    background-color: var(--rector-highlighted);
}

.rector-node-category-button-inner {
    background-color: rgba(20, 20, 20, 0.7);
    border-width: 0;
    margin: 0;
    padding: 0;
    color: var(--rector-text-color);
    font-size: 12px;
    -unity-text-align: middle-left;
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
}

.rector-node-category-button--focused > .rector-node-category-button-inner {
    background-color: black;
}

.rector-node-category-button-icon {
    width: 16px;
    height: 16px;
    margin-right: 4px;
    -unity-background-image-tint-color: var(--rector-text-color);
    flex-shrink: 0;
}

/* グラフ右下の操作ガイド。中心軸を挟んだ2カラムの固定グリッドで、
   左セルは右揃え(軸に吸着)、右セルは左揃え。ステートで文言と減光だけが変わり、
   位置・幅は一切動かない */
.rector-input-guide {
    position: absolute;
    right: 8px;
    bottom: 8px;
    flex-direction: column;
    align-items: flex-start;
}

.rector-input-guide__row {
    flex-direction: row;
}

/* セルは透明な位置決め箱。塗りは文字幅ぴったりの内側チップにだけ載せる */
.rector-input-guide__cell {
    width: 130px;
    flex-direction: row;
    margin: 1px 2px;
}

.rector-input-guide__cell--left {
    justify-content: flex-end;
}

.rector-input-guide__cell--right {
    justify-content: flex-start;
}

.rector-input-guide__chip {
    font-size: 10px;
    letter-spacing: 2px;
    padding: 1px 6px;
    color: var(--rector-text-color);
    background-color: var(--rector-text-background-color);
}

.rector-input-guide__chip--active {
    color: white;
    background-color: black;
}

.rector-input-guide__chip--disabled {
    opacity: 0.25;
}

.rector-input-guide__gap {
    height: 8px;
}

/* ○の行を中心軸から右へずらしてパッドの菱形に寄せる */
.rector-input-guide__face-offset {
    width: 60px;
}

/* ショルダーのR側は△ボタンの右端あたりから始める(L/R間の余白) */
.rector-input-guide__shoulder-gutter {
    width: 36px;
}
