.rector-node {
    border-width: 1px;
    background-color: rgba(0, 0, 0, 0);
    position: absolute;
    flex-shrink: 0;
    transition-property: translate;
    transition-duration: 0.2s;
    transition-timing-function: ease-in-out;
    translate: 60px 30px;
}

.rector-node-name-label {
    font-size: 12px;
}

.rector-node-content {
    flex-direction: row;
    /* ラベルが .rector-label で同じ黒0.2を重ねていてテキスト側だけ濃かったので、下地はここ1枚に集約する。
       0.36 は黒0.2を2枚重ねた合成値 (1 - 0.8 * 0.8) */
    background-color: rgba(0, 0, 0, 0.36);
}

/* .rector-label(RectorCommon) の背景を消す。同スペシフィシティだとそちらが勝つので子セレクタで上書きする */
.rector-node-content > .rector-node-name-label {
    background-color: rgba(0, 0, 0, 0);
}

.rector-node-icon {
    width: 16px;
    height: 16px;
    -unity-background-image-tint-color: var(--rector-text-color);
    margin-right: 2px;
}

.rector-node--selected {
    border-color: var(--rector-border-color);
}

.rector-node--selected > .rector-node-content {
    background-color: black;
}

.rector-node-slot-list {
    height: 2px;
    flex-direction: row;
    justify-content: space-between;
    margin-right: -5px;
    margin-left: -5px;
}

.rector-node-input-slot-list {
    margin-top: -1px;
}

.rector-node-output-slot-list {
    margin-bottom: -1px;
}

.rector-node-slot {
    width: 7px;
    height: 2px;
    margin-left: 4px;
    margin-right: 4px;
    background-color: rgba(255, 255, 255, 0.1);
}

.rector-node-input-slot {
    flex-direction: column-reverse;
}

.rector-node-slot-name-label {
    font-size: 10px;
    padding: 0 2px;
    margin-left: 4px;
    display: none;
    position: absolute;
    background-color: black;
}

.rector-node-input-slot-name-label {
    -unity-text-align: lower-left;
    bottom: 3px;
}

.rector-node-output-slot-name-label {
    -unity-text-align: upper-left;
    top: 3px;
}

.rector-node-slot--active {
    background-color: rgba(255, 255, 255, 0.5);
}

.rector-node-slot--selected {
    background-color: white;
}

.rector-node-slot--selected > .rector-node-slot-name-label {
    display: flex;
}

/* MIDIノードの値ゲージ。面で塗るとフォーカス中の黒背景を覆ってしまうので、下端のバーで示す */
.rector-node-value-gauge {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 0;
    background-color: rgba(255, 255, 255, 0.5);
}

.rector-node-mute {
    height: 1px;
    background-color: rgba(255, 255, 255, 0.5);
    position: absolute;
    flex-grow: 1;
    flex-shrink: 0;
    width: 100%;
    top: 50%;
    color: rgba(255, 255, 255, 0.39);
    display: none;
}

.rector-node--muted > .rector-node-mute {
    display: flex;
}

.rector-hold-guide {
    position: absolute;
    flex-shrink: 0;
    background-color: rgba(0, 0, 0, 0);
    width: 20px;
    height: 20px;
    border-radius: 50%;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    justify-content: center;
    align-items: center;
}

.rector-hold-guide__fill {
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
    height: 0;
    width: 0;
}

.rector-hold-guide__fill--filled {
    height: 100%;
    width: 100%;
    transition-property: height, width;
    transition-duration: 0.3s;
    transition-timing-function: linear;
}

/* ターゲットは色ではなく、一回り大きいアウトラインで示す */
.rector-node-target-outline {
    position: absolute;
    left: -5px;
    right: -5px;
    top: -5px;
    bottom: -5px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.5);
    display: none;
}

.rector-node--target > .rector-node-target-outline {
    display: flex;
}

.rector-node--target > .rector-node-content {
    background-color: black;
}

.rector-node-slot--target {
    background-color: white;
}

.rector-node-slot--target > .rector-node-slot-name-label {
    display: flex;
}

/* R2で掴んでいる間、ノードの左右に点滅する塗りつぶし三角(◀▶)を出す */
.rector-node-grab-arrow {
    position: absolute;
    top: 0;
    bottom: 0;
    /* Labelの既定margin(2px)を消して縦センターを正確にする */
    margin: 0;
    -unity-text-align: middle-center;
    font-size: 12px;
    color: var(--rector-text-color);
    display: none;
    transition-property: opacity;
    transition-duration: 0.5s;
}

.rector-node-grab-arrow-left {
    right: 100%;
    margin-right: 6px;
}

.rector-node-grab-arrow-right {
    left: 100%;
    margin-left: 6px;
}

.rector-node--grabbed > .rector-node-grab-arrow {
    display: flex;
}
